# ==========================================
# STAGE 1: Builder
# Node.js environment to install dependencies and build the static React assets.
# ==========================================
FROM node:20-alpine AS builder

# Set the working directory inside the container
WORKDIR /app

# Copy package.json and package-lock.json first to leverage Docker's layer caching
COPY package*.json ./

# Configure npm for unstable/slow networks to prevent connection timeouts and hangs
RUN npm config set maxsockets 3 && \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000

# Install exact dependency versions from package-lock.json with increased memory limit
RUN NODE_OPTIONS="--max-old-space-size=3072" npm ci


# Copy the rest of the frontend source files required for the build
# We include all tsconfig variants as tsconfig.json references them
COPY vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json tailwind.config.ts index.html ./
COPY src/ ./src/
COPY public/ ./public/

# Set the VITE_API_URL build argument (defaults to empty since production API is proxied)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

# Run the production build. Outputs static files to "/app/dist"
RUN npm run build


# ==========================================
# STAGE 2: Runner
# Lightweight Nginx server to host the production static files.
# ==========================================
FROM nginx:alpine AS runner

# Copy the built static assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy the custom Nginx configuration file for frontend routing and caching
# Note: Ensure nginx-frontend.conf is in your Docker build context when building this image.
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Expose port 80 to the container network
EXPOSE 80

# Start Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
