# ==========================================
# STAGE 1: Builder
# Compiles the TypeScript application and generates the Prisma client.
# ==========================================
FROM node:22-alpine AS builder

# Set the working directory in the build container
WORKDIR /app

# Copy package.json and package-lock.json first to leverage Docker's layer caching.
# This prevents reinstalling dependencies if package files haven't changed.
COPY package*.json ./

# Disable Chromium/Puppeteer download to speed up installation and prevent memory crashes
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Configure npm for unstable/slow networks to prevent connection timeouts and hangs
RUN npm config set maxsockets 3 && \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000

# Install only production dependencies (ignoring heavy devDependencies like prisma-erd-generator)
RUN NODE_OPTIONS="--max-old-space-size=3072" npm install --omit=dev --no-audit --no-fund

# Install build-only tools locally without saving them to package.json/package-lock.json
RUN NODE_OPTIONS="--max-old-space-size=3072" npm install --no-save typescript prisma tsc-alias

# Copy the prisma folder containing the schema. prisma generate requires the schema to run.
COPY prisma ./prisma/
COPY prisma.config.ts ./

# Strip the dbml generator block from schema.prisma to avoid missing generator errors during build
RUN sed -i '/generator dbml {/,/}/d' prisma/schema.prisma

# Generate the Prisma client. This generates the TypeScript definitions and
# engine binaries based on our schema definitions.
RUN npx prisma generate

# Copy the remaining application source files (tsconfig.json, src directory, etc.)
COPY tsconfig.json ./
COPY src ./src/
COPY scripts ./scripts/


# Compile the TypeScript files into the 'dist/' directory as plain JavaScript.
RUN npm run build


# ==========================================
# STAGE 2: Runner
# A minimal production image containing only the compiled code and production dependencies.
# ==========================================
FROM node:22-alpine AS runner

# Install openssl for Prisma client database connection
RUN apk add --no-cache openssl

# Set the working directory in the runner container
WORKDIR /app

# Set the environment variable to production
ENV NODE_ENV=production

# Create a non-root user and group for security compliance
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy only the compiled application code from the builder stage with ownership
COPY --chown=appuser:appgroup --from=builder /app/dist ./dist

# Copy the generated Prisma client files that are not compiled by tsc
COPY --chown=appuser:appgroup --from=builder /app/src/generated/prisma ./dist/generated/prisma

# Copy the installed node_modules from the builder stage (contains production packages and prisma client)
COPY --chown=appuser:appgroup --from=builder /app/node_modules ./node_modules

# Copy the prisma folder from the builder stage (needed for running database migrations in production)
COPY --chown=appuser:appgroup --from=builder /app/prisma ./prisma
COPY --chown=appuser:appgroup --from=builder /app/prisma.config.ts ./

# Copy package.json and package-lock.json to access defined npm start scripts
COPY --chown=appuser:appgroup --from=builder /app/package*.json ./

# Expose the application port
EXPOSE 4000

# Switch to the non-root user so the container doesn't run with root privileges
USER appuser

# Run database migrations first to update the database schema, then start the server
CMD ["sh", "-c", "npx prisma migrate deploy && npm run start"]
